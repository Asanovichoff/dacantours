{
  // Assets-only Worker: there is no server code, so `main` is intentionally
  // omitted. Cloudflare serves ./out directly. Requests to static assets are
  // free and unlimited — only Worker script invocations are billed, and this
  // Worker has no script.
  //
  // NOTE: "name" must match the Worker's name in the Cloudflare dashboard,
  // otherwise `wrangler deploy` creates a second Worker instead of updating
  // the existing one.
  "name": "dacantours",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./out",
    // next.config.ts sets trailingSlash: true, so URLs are normalised to match.
    "html_handling": "force-trailing-slash",
    // Serves out/404.html for unmatched routes.
    "not_found_handling": "404-page"
  }
}
